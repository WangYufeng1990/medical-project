{
  "$defs": {
    "CitationPayload": {
      "additionalProperties": false,
      "properties": {
        "chunk_id": {
          "maxLength": 80,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Chunk Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "document_id": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Document Id",
          "type": "string"
        },
        "document_version": {
          "exclusiveMinimum": 0,
          "title": "Document Version",
          "type": "integer"
        },
        "heading_path": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Heading Path",
          "type": "array"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "chunk_id",
        "document_id",
        "document_version",
        "title",
        "heading_path",
        "content_hash"
      ],
      "title": "CitationPayload",
      "type": "object"
    },
    "Intent": {
      "enum": [
        "APPOINTMENT",
        "PRESCRIPTION_REFILL",
        "BILLING",
        "LAB_RESULTS",
        "CLINICAL_QUESTION",
        "ADMINISTRATIVE_REQUEST",
        "OTHER"
      ],
      "title": "Intent",
      "type": "string"
    },
    "RiskLevel": {
      "enum": [
        "ROUTINE",
        "URGENT",
        "EMERGENCY"
      ],
      "title": "RiskLevel",
      "type": "string"
    },
    "ToolFact": {
      "additionalProperties": false,
      "description": "One appointment as the tool returned it (Round 58.2): the 58.1 fields, nothing clinical.",
      "properties": {
        "appointment_id": {
          "exclusiveMinimum": 0,
          "title": "Appointment Id",
          "type": "integer"
        },
        "department": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Department"
        },
        "duration_minutes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Minutes"
        },
        "provider_name": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Name"
        },
        "start_time": {
          "maxLength": 40,
          "minLength": 10,
          "title": "Start Time",
          "type": "string"
        },
        "status": {
          "minimum": 0,
          "title": "Status",
          "type": "integer"
        },
        "timezone": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Timezone",
          "type": "string"
        }
      },
      "required": [
        "appointment_id",
        "status",
        "start_time",
        "timezone"
      ],
      "title": "ToolFact",
      "type": "object"
    },
    "ToolPayload": {
      "additionalProperties": false,
      "description": "What the run's read-only tool did, for the review context (Round 58.2).",
      "properties": {
        "facts": {
          "items": {
            "$ref": "#/$defs/ToolFact"
          },
          "maxItems": 5,
          "title": "Facts",
          "type": "array"
        },
        "name": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "tool_failed",
                "deadline_exceeded",
                "call_budget_exhausted",
                "tool_unavailable"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "status": {
          "enum": [
            "ok",
            "needs_human"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "name",
        "status",
        "facts"
      ],
      "title": "ToolPayload",
      "type": "object"
    },
    "ValidationPayload": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "ok": {
          "title": "Ok",
          "type": "boolean"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Reasons",
          "type": "array"
        },
        "rejected_reasons": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Rejected Reasons",
          "type": "array"
        }
      },
      "required": [
        "ok",
        "kind",
        "reasons",
        "rejected_reasons"
      ],
      "title": "ValidationPayload",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The result a worker submits for one generation of one run.",
  "properties": {
    "citations": {
      "items": {
        "$ref": "#/$defs/CitationPayload"
      },
      "maxItems": 8,
      "title": "Citations",
      "type": "array"
    },
    "contract_version": {
      "const": "v1",
      "default": "v1",
      "title": "Contract Version",
      "type": "string"
    },
    "draft": {
      "maxLength": 1500,
      "minLength": 1,
      "title": "Draft",
      "type": "string"
    },
    "generation": {
      "exclusiveMinimum": 0,
      "title": "Generation",
      "type": "integer"
    },
    "intent": {
      "$ref": "#/$defs/Intent"
    },
    "requires_clinician": {
      "title": "Requires Clinician",
      "type": "boolean"
    },
    "risk": {
      "$ref": "#/$defs/RiskLevel"
    },
    "run_id": {
      "exclusiveMinimum": 0,
      "title": "Run Id",
      "type": "integer"
    },
    "tool": {
      "anyOf": [
        {
          "$ref": "#/$defs/ToolPayload"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "validation": {
      "$ref": "#/$defs/ValidationPayload"
    }
  },
  "required": [
    "run_id",
    "generation",
    "intent",
    "risk",
    "requires_clinician",
    "draft",
    "citations",
    "validation"
  ],
  "title": "RunResultRequest",
  "type": "object"
}
