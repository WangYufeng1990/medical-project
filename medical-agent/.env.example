# Copy to .env (gitignored) and fill in real values.
MEDICAL_AGENT_PROVIDER=deepseek            # mock | deepseek
MEDICAL_AGENT_DEEPSEEK_API_KEY=sk-replace-me
MEDICAL_AGENT_DEEPSEEK_MODEL=deepseek-chat
MEDICAL_AGENT_DEEPSEEK_BASE_URL=https://api.deepseek.com
# Java -> Python credential (Java: app.agent.outbound-token / AGENT_OUTBOUND_TOKEN)
MEDICAL_AGENT_INBOUND_TOKEN=dev-inbound-token
# Python -> Java credential (Java: app.agent.inbound-token / AGENT_INBOUND_TOKEN)
MEDICAL_AGENT_OUTBOUND_TOKEN=dev-outbound-token
MEDICAL_AGENT_JAVA_BASE_URL=http://localhost:8080
MEDICAL_AGENT_CHECKPOINT_URL=sqlite://./.agent/checkpoints.sqlite
MEDICAL_AGENT_REQUEST_TIMEOUT_SECONDS=30
